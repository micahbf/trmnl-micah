# Google Calendar → Settings → (your calendar) → "Secret address in iCal format".
# Comma-separate multiple calendars.
GCAL_ICS_URLS=

# Optional: hide events by title. Comma-separated; plain entries match anywhere,
# ignoring case; /pattern/flags entries are regexes (no commas inside them).
# e.g. HIDE_TITLES=Focus time,OOO,/^Hold:/
HIDE_TITLES=

# Optional: require ?key=<value> on every request once this is deployed publicly.
SCREEN_KEY=

# Optional: TRMNL Webhook Image plugin URL. When set, the server pushes the screen
# there every 5 minutes (skipping unchanged images). Treat it like a password.
TRMNL_WEBHOOK_URL=

# IANA zone to display times in (defaults to this machine's zone).
TZ_DISPLAY=

PORT=3000
# Docker only: host port to publish on (default 3000). PORT/HOST are ignored in Docker.
HOST_PORT=

# Interface to listen on. Keep 127.0.0.1 when Caddy runs on the same machine.
HOST=127.0.0.1
