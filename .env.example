# Google Calendar → Settings → (your calendar) → "Secret address in iCal format".
# Comma-separate multiple calendars.
GCAL_ICS_URLS=

# Optional: require ?key=<value> on every request once this is deployed publicly.
SCREEN_KEY=

# IANA zone to display times in (defaults to this machine's zone).
TZ_DISPLAY=

PORT=3000
# Interface to listen on. Keep 127.0.0.1 when Caddy runs on the same machine.
HOST=127.0.0.1
